# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# banco local (SQLite)
data/*.db
data/*.db-wal
data/*.db-shm

# logs de execucao do servidor
data/*.log

# saidas do modo OMEGA (modelos decensored e logs do Heretic)
data/omega/

# repo do Heretic clonado localmente (0xSojalSec/Uncensored-AI)
tools/Uncensored-AI/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
