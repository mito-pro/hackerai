# Segredo usado para assinar sessoes e criptografar chaves de API (AES-256-GCM).
# Obrigatorio em producao. Gere um valor aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=troque-este-valor-em-producao

# Banco de dados. Com DATABASE_URL preenchido o app usa Postgres (Neon ou
# qualquer Postgres compativel). Sem ele, usa SQLite local em ./data/hackerai.db.
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_PATH=./data/hackerai.db

# E-mails que sempre recebem papel de administrador (separados por virgula).
# O primeiro usuario registrado tambem vira administrador.
ADMIN_EMAILS=admin@exemplo.com

# Provedores de IA gratuitos (tambem podem ser cadastrados no painel admin).
# Se a variavel existir, o provedor aparece como disponivel mesmo sem cadastrar no admin.
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Provedores extras com API compativel com OpenAI (cota gratuita).
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=

# OpenCode Console :: modelos gratuitos (chave criada em opencode.ai/console).
OPENCODE_API_KEY=

# Vercel AI Gateway :: modelos premium (chave vck_ criada no painel da Vercel).
VERCEL_AI_GATEWAY_API_KEY=

# RunAPI :: video, imagem e audio (chave criada em runapi.ai/login).
RUNPI_API_KEY=

# Heap do Node.js em MB (usado pelos scripts npm run dev/build/start).
NODE_OPTIONS=--max-old-space-size=4096

# Ollama local (modelo do seu PC).
# Defina OLLAMA_BASE_URL para habilitar o provedor Ollama no seletor de modelos.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# NEXUS OMEGA :: modo sem censura (repo 0xSojalSec/Uncensored-AI / Heretic).
# Caminho do repo clonado (padrao: ./tools/Uncensored-AI).
HERETIC_REPO_PATH=./tools/Uncensored-AI

# SMTP opcional para envio do codigo OTP por e-mail.
# Sem SMTP o codigo e impresso no console do servidor e exibido na tela em dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HACKER AI <no-reply@exemplo.com>
